# Public URL of a server-side lodging adapter. Never place provider secrets in VITE_*.
VITE_LODGING_API_URL=

# Where a submitted fundraiser link goes. submitFundraiser() in
# web/src/detainee-lookup.ts tries the endpoint first and falls back to a
# prefilled mailto:; with neither set the submit path dead-ends and the
# submitter's work is lost. Only one is needed.
#
# Both are inlined into the public bundle at build time, so neither may carry a
# secret or a private address -- the endpoint must be a public intake URL that
# does its own validation, and the email must be an address the partner is
# willing to publish.
VITE_INTAKE_ENDPOINT=
VITE_INTAKE_EMAIL=
